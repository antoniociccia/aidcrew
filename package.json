{
  "name": "aidcrew-monorepo",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "gpt-tokenizer": "^4.0.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.5.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": true,
  "scripts": {
    "start": "bun packages/cli/src/bin.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "version:set": "bun scripts/version.ts"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "dependencies": {
    "@aidcrew/cli": "workspace:*",
    "@aidcrew/core": "workspace:*",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "license": "MIT"
}
