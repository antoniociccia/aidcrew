import { expect, test } from 'bun:test'
import { Cache } from './cache.ts'

function clock() {
  let at = 0
  return { now: () => at, tick: (ms: number) => { at += ms } }
}

test('returns nothing for a missing key', () => {
  const cache = new Cache<string, number>(2, 1000, clock().now)
  expect(cache.get('a')).toBeUndefined()
  expect(cache.has('a')).toBe(false)
})

test('evicts the least recently used entry past capacity, and a get counts as a use', () => {
  const cache = new Cache<string, number>(2, 1000, clock().now)
  cache.set('a', 1)
  cache.set('b', 2)
  cache.get('a')
  cache.set('c', 3)
  expect(cache.has('b')).toBe(false)
  expect(cache.get('a')).toBe(1)
  expect(cache.get('c')).toBe(3)
})

test('replacing a key evicts nothing', () => {
  const cache = new Cache<string, number>(2, 1000, clock().now)
  cache.set('a', 1)
  cache.set('b', 2)
  cache.set('a', 3)
  expect(cache.get('a')).toBe(3)
  expect(cache.get('b')).toBe(2)
  expect(cache.size).toBe(2)
})

test('an entry expires ttl after it was set', () => {
  const time = clock()
  const cache = new Cache<string, number>(2, 100, time.now)
  cache.set('a', 1)
  time.tick(99)
  expect(cache.get('a')).toBe(1)
  time.tick(1)
  expect(cache.get('a')).toBeUndefined()
  expect(cache.has('a')).toBe(false)
})

test('size counts only live entries', () => {
  const time = clock()
  const cache = new Cache<string, number>(5, 100, time.now)
  cache.set('a', 1)
  cache.set('b', 2)
  time.tick(50)
  cache.set('c', 3)
  time.tick(60)
  expect(cache.size).toBe(1)
})

test('delete says whether there was a live entry', () => {
  const time = clock()
  const cache = new Cache<string, number>(5, 100, time.now)
  cache.set('a', 1)
  expect(cache.delete('a')).toBe(true)
  expect(cache.delete('a')).toBe(false)
  cache.set('b', 2)
  time.tick(100)
  expect(cache.delete('b')).toBe(false)
})

test('a capacity below 1 is refused', () => {
  expect(() => new Cache<string, number>(0, 100)).toThrow(RangeError)
})
