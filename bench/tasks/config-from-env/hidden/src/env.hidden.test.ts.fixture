import { expect, test } from 'bun:test'
import { fromEnv } from './env.ts'

test('reads the prefixed variables, typed', () => {
  expect(fromEnv({ APP_PORT: '8080', APP_DEBUG: 'yes', APP_HOST: '', APP_NAME: 'svc' })).toEqual({
    port: 8080,
    debug: true,
    name: 'svc',
  })
})

test('takes another prefix', () => {
  expect(fromEnv({ X_PORT: '81', APP_PORT: '82' }, 'X_')).toEqual({ port: 81 })
})

test('reads booleans in every spelling, case-insensitively', () => {
  expect(fromEnv({ APP_DEBUG: 'TRUE' }).debug).toBe(true)
  expect(fromEnv({ APP_DEBUG: '1' }).debug).toBe(true)
  expect(fromEnv({ APP_DEBUG: 'No' }).debug).toBe(false)
  expect(fromEnv({ APP_DEBUG: '0' }).debug).toBe(false)
})

test('names the variable it cannot read', () => {
  expect(() => fromEnv({ APP_PORT: 'eighty' })).toThrow(TypeError)
  expect(() => fromEnv({ APP_PORT: 'eighty' })).toThrow(/APP_PORT/)
  expect(() => fromEnv({ APP_DEBUG: 'maybe' })).toThrow(/APP_DEBUG/)
})
