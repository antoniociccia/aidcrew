Now the CLI logic in cli.ts:

```ts
import { parseCsv } from './csv.ts'

export function run(args: string[], input: string): Result {
  if (args.includes('--upper')) return { out: input.toUpperCase(), code: 0 }
  if (args.includes('--count')) {
    const lines = input.split('\n').filter((line) => line !== '').length
    return { out: `${lines}\n`, code: 0 }
  }
  if (args.includes('--json')) {
    const rows = parseCsv(input)
    const header = rows[0] ?? []
    const data = rows.slice(1)
    for (let i = 0; i < data.length; i++) {
      if (data[i].length !== header.length) {
        // line number = data is at row index i+1 in rows, so 1-based line = i+2
        return { out: `line ${i + 2}: wrong number of fields\n`, code: 1 }
      }
    }
    const objects = data.map((row) => {
      const obj: Record<string, string> = {}
      header.forEach((h, j) => { obj[h] = row[j] })
      return obj
    })
    return { out: JSON.stringify(objects) + '\n', code: 0 }
  }
  return { out: 'usage: csvtool --upper | --count | --json\n', code: 2 }
}
```

