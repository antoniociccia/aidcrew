```ts
export function parseCsv(text: string): string[][] {
  const rows: string[][] = []
  let row: string[] = []
  let field = ''
  let inQuotes = false

  const i = 0
  while (i < text.length) {
    const c = text[i]
    if (inQuotes) {
      if (c === '"') {
        if (text[i + 1] === '"') {
          field += '"'
          i++
        } else {
          inQuotes = false
        }
      } else {
        field += c
      }
      i++
    } else {
      if (c === '"' && field === '') {
        inQuotes = true
        i++
      } else if (c === ',') {
        row.push(field)
        field = ''
        i++
      } else if (c === '\n') {
        row.push(field)
        rows.push(row)
        row = []
        field = ''
        i++
      } else if (c === '\r') {
        // check if next is \n; if so handled at \n, else treat \r as part of line
        // Actually treat \r as char to be handled
        if (text[i + 1] === '\n') {
          i++ // will be consumed as \n
        } else {
          field += c
          i++
        }
      } else {
        field += c
        i++
      }
    }
  }
  // flush last
  ...
}
```

