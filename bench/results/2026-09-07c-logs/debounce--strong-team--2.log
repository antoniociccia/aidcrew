## What `src/debounce.ts` should do

Keep the existing `Timers`, `Debounced`, and `GLOBAL_TIMERS` definitions unchanged. Replace only the body of `debounce`:

- If `ms < 0`, throw `new RangeError(...)` immediately.
- Track a pending timer handle and the arguments of the most recent call.
- Each call stores the latest args, clears any existing timer, and schedules a new one with `timers.setTimeout`.
- When the timer fires (or `flush()` is called), run `fn` once with the stored latest args and clear the pending state.
- `cancel()` clears the timer and drops the pending args without calling `fn`.
- `flush()` is a no-op when nothing is pending; otherwise it clears the timer and invokes the pending call immediately.

Exact implementation to use:

```ts
/** A version of fn that runs once, ms after the most recent call. */
export function debounce<A extends unknown[]>(
  fn: (...args: A) => void,
  ms: number,
  timers: Timers = GLOBAL_TIMERS,
): Debounced<A> {
  if (ms < 0) {
    throw new RangeError(`debounce ms must be >= 0, got ${ms}`)
  }

  let timer: unknown
  let lastArgs: A | undefined

  const invoke = () => {
    if (lastArgs === undefined) {
      return
    }
    const args = lastArgs
    lastArgs = undefined
    timer = undefined
    fn(...args)
  }

  const debounced = ((...args: A): void => {
    lastArgs = args
    if (timer !== undefined) {
      timers.clearTimeout(timer)
    }
    timer = timers.setTimeout(invoke, ms)
  }) as Debounced<A>

  debounced.cancel = (): void => {
    if (timer !== undefined) {
      timers.clearTimeout(timer)
      timer = undefined
    }
    lastArgs = undefined
  }

  debounced.flush = (): void => {
    if (timer === undefined) {
      return
    }
    timers.clearTimeout(timer)
    timer = undefined
    invoke()
  }

  return debounced
}
```

## What `src/debounce.test.ts` should do

Keep the existing `returns a function` test, add a controllable fake timer (so tests control time through the `timers` argument), and add tests for:

1. `ms < 0` throws `RangeError`.
2. Calls before `ms` elapses produce exactly one call with the most recent arguments.
3. A call within `ms` resets the timer (advance partway, call again, verify nothing fires too early and only the latest args fire).
4. `cancel()` drops a pending call.
5. `flush()` runs a pending call immediately and cancels its timer.
6. `cancel()`/`flush()` with nothing pending are no-ops.

Use this test file:

```ts
import { expect, test } from 'bun:test'
import { debounce } from './debounce.ts'

function createFakeTimers() {
  let nextId = 1
  let now = 0
  const pending = new Map<unknown, { fn: () => void; at: number }>()

  return {
    setTimeout: (fn: () => void, ms: number) => {
      const id = nextId++
      pending.set(id, { fn, at: now + ms })
      return id
    },
    clearTimeout: (handle: unknown) => {
      pending.delete(handle)
    },
    advance: (ms: number) => {
      now += ms
      const due = [...pending.entries()].filter(([, timer]) => timer.at <= now)
      for (const [id, timer] of due) {
        pending.delete(id)
        timer.fn()
      }
    },
    pendingCount: () => pending.size,
  }
}

test('returns a function', () => {
  expect(typeof debounce(() => {}, 10)).toBe('function')
})

test('throws a RangeError when ms is below 0', () => {
  expect(() => debounce(() => {}, -1)).toThrow(RangeError)
})

test('calls fn once with the most recent arguments after ms', () => {
  const timers = createFakeTimers()
  const calls: Array<[string, number]> = []
  const d = debounce((name: string, n: number) => calls.push([name, n]), 100, timers)

  d('a', 1)
  d('b', 2)
  d('c', 3)

  expect(calls).toEqual([])
  expect(timers.pendingCount()).toBe(1)

  timers.advance(100)

  expect(calls).toEqual([['c', 3]])
  expect(timers.pendingCount()).toBe(0)
})

test('resets the timer when called again within ms', () => {
  const timers = createFakeTimers()
  const calls: number[] = []
  const d = debounce((n: number) => calls.push(n), 100, timers)

  d(1)
  timers.advance(60)
  d(2)

  timers.advance(40)
  expect(calls).toEqual([])

  timers.advance(60)
  expect(calls).toEqual([2])
})

test('cancel drops a pending call', () => {
  const timers = createFakeTimers()
  const calls: number[] = []
  const d = debounce((n: number) => calls.push(n), 100, timers)

  d(1)
  d.cancel()

  timers.advance(200)
  expect(calls).toEqual([])
  expect(timers.pendingCount()).toBe(0)
})

test('flush runs a pending call immediately and cancels its timer', () => {
  const timers = createFakeTimers()
  const calls: number[] = []
  const d = debounce((n: number) => calls.push(n), 100, timers)

  d(1)
  d.flush()

  expect(calls).toEqual([1])
  expect(timers.pendingCount()).toBe(0)

  timers.advance(200)
  expect(calls).toEqual([1])
})

test('flush and cancel are no-ops when nothing is pending', () => {
  const timers = createFakeTimers()
  const calls: number[] = []
  const d = debounce((n: number) => calls.push(n), 100, timers)

  d.flush()
  d.cancel()
  timers.advance(200)

  expect(calls).toEqual([])
})
```

