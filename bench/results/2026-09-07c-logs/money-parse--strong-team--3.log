Let me think through the algorithm carefully:

1. **Currency detection**: Find leftmost occurrence of any of the six tokens (`€`, `EUR`, `$`, `USD`, `£`, `GBP`). That token decides the currency. If none found, throw TypeError. Then remove all six tokens from the string.

2. **Sign**: Trim. If starts with `(` and ends with `)`, mark negative, strip both, trim again. If then starts with `-`, mark negative, strip it, trim again.

3. **Number extraction**: Keep only digits, `.`, `,`, spaces. Drop everything else. Trim. If no digit, throw TypeError.

4. **Decimal vs Grouping**: Remove all spaces. Look at last `.` or `,`. If the substring after it is exactly 2 digits → decimal separator. Otherwise no decimal part.

5. **Cents**: Strip everything non-digit, parse as integer. If decimal separator existed, cents = integerPart*100 + decimalPart. Otherwise cents = parsedInteger*100. Apply negative sign. Integer math.

6. Return.

Let me write this out:

```typescript
export type Money = { cents: number; currency: 'EUR' | 'USD' | 'GBP' }

const CURRENCY_TOKENS: Record<string, 'EUR' | 'USD' | 'GBP'> = {
  '€': 'EUR',
  'EUR': 'EUR',
  '$': 'USD',
  'USD': 'USD',
  '£': 'GBP',
  'GBP': 'GBP',
}

/** An amount as people write it, read into cents and a currency code. */
export function parseMoney(text: string): Money {
  // 1. Currency detection
  let currency: 'EUR' | 'USD' | 'GBP' | null = null
  let leftmostIndex = Infinity
  for (const token of Object.keys(CURRENCY_TOKENS)) {
    const idx = text.indexOf(token)
    if (idx !== -1 && idx < leftmostIndex) {
      leftmostIndex = idx
      currency = CURRENCY_TOKENS[token]
    }
  }
  if (currency === null) {
    throw new TypeError(`No recognized currency found in: ${text}`)
  }

  // Remove all currency tokens
  let s = text
  for (const token of Object.keys(CURRENCY_TOKENS)) {
    s = s.split(token).join('')
  }

  // 2. Sign
  let negative = false
  s = s.trim()
  if (s.startsWith('(') && s.endsWith(')')) {
    negative = true
    s = s.slice(1, -1).trim()
  }
  if (s.startsWith('-')) {
    negative = true
    s = s.slice(1).trim()
  }

  // 3. Number extraction
  s = s.replace(/[^0-9., ]/g, '').trim()
  if (!/\d/.test(s)) {
    throw new TypeError(`No digits found in: ${text}`)
  }

  // 4. Decimal vs grouping
  s = s.replace(/ /g, '')
  const lastSepIndex = Math.max(s.lastIndexOf('.'), s.lastIndexOf(','))
  let hasDecimal = false
  if (lastSepIndex !== -1) {
    const afterSep = s.slice(lastSepIndex + 1)
    if (afterSep.length === 2 && /^\d\d$/.test(afterSep)) {
      hasDecimal = true
    }
  }

  // 5. Cents
  const digits = s.replace(/[^0-9]/g, '')
  let cents: number
  if (hasDecimal) {
    // digits = integerPart + decimalPart (the last two digits are decimals)
    const integerPart = Number(digits.slice(0, -2))
    const decimalPart = Number(digits.slice(-2))
    cents = integerPart * 100 + decimalPart
  } else {
    cents = Number(digits) * 100
  }

  if (negative) {
    cents = -cents
  }

  return { cents, currency }
}
```

